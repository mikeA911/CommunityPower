# Browser-facing application origin. Add this URL to each Supabase Auth redirect allowlist.
PUBLIC_SITE_URL=http://127.0.0.1:3000

# Sandz control project. Keep the service-role key server-side and out of Git.
SUPABASE_CONTROL_URL=https://YOUR_CONTROL_PROJECT.supabase.co
SUPABASE_CONTROL_PUBLISHABLE_KEY=YOUR_CONTROL_PUBLISHABLE_KEY
SUPABASE_CONTROL_SERVICE_ROLE_KEY=YOUR_CONTROL_SERVICE_ROLE_KEY

# First community project.
SUPABASE_COMMUNITY_ID=pilot
SUPABASE_COMMUNITY_URL=https://YOUR_COMMUNITY_PROJECT.supabase.co
SUPABASE_COMMUNITY_PUBLISHABLE_KEY=YOUR_COMMUNITY_PUBLISHABLE_KEY
SUPABASE_COMMUNITY_SERVICE_ROLE_KEY=YOUR_COMMUNITY_SERVICE_ROLE_KEY

# Local bootstrap inputs. Put real addresses only in the ignored .env.local file.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform-admin@example.invalid
BOOTSTRAP_COMMUNITY_ADMIN_EMAIL=community-admin@example.invalid
BOOTSTRAP_CONSUMER_EMAIL=consumer@example.invalid
